<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- Comma-separated tile ids, in display order. Unknown ids are ignored,
         missing ones are appended (hidden), so new tiles appear in the
         editor after upgrades without changing the user's layout. -->
    <entry name="tileOrder" type="String">
      <default>clock,specs,cpu,gpu,memory,temps,network,cores,processes,power,disk,battery</default>
    </entry>
    <entry name="hiddenTiles" type="String">
      <default>cores,processes,power,disk,battery</default>
    </entry>
    <entry name="preset" type="String">
      <default>essentials</default>
    </entry>
    <!-- True once tiles were moved, resized, shown or hidden after picking
         the preset; Reset layout re-applies the preset. -->
    <entry name="customized" type="Bool">
      <default>false</default>
    </entry>
    <!-- auto | compact | comfortable | large | huge -->
    <entry name="density" type="String">
      <default>auto</default>
    </entry>
    <!-- Per-tile size overrides, "id:spanIndex" pairs, e.g. "cpu:2,clock:0". -->
    <entry name="tileSpans" type="String">
      <default></default>
    </entry>
    <!-- Set (e.g. by "install.sh place full") to ask the running widget to
         move/resize itself; the widget clears it once applied. -->
    <!-- Hand-edited layout: "id:x,y,w,h;..." in grid cells. Empty means
         the automatic layout. -->
    <entry name="tileRects" type="String">
      <default></default>
    </entry>
    <!-- Shape and material: plasma (native), glass, flat, clear, pixel -->
    <entry name="style" type="String">
      <default>plasma</default>
    </entry>
    <!-- Colors: plasma (follow the system) or a theme id from palette.js -->
    <entry name="theme" type="String">
      <default>plasma</default>
    </entry>
    <!-- auto (from the widget's shape), landscape or portrait -->
    <entry name="orientation" type="String">
      <default>auto</default>
    </entry>
    <!-- binary (KiB, GiB) or decimal (kB, GB) -->
    <entry name="dataUnits" type="String">
      <default>binary</default>
    </entry>
    <!-- Network speeds in bits per second (Mbps) instead of bytes -->
    <entry name="networkBits" type="Bool">
      <default>false</default>
    </entry>
    <!-- Hide hostname, network name, IP and weather location -->
    <entry name="maskSensitive" type="Bool">
      <default>true</default>
    </entry>
    <!-- Sticky note text -->
    <entry name="noteText" type="String">
      <default></default>
    </entry>
    <!-- World clocks: "Name|IANA zone" separated by ";" -->
    <entry name="worldClocks" type="String">
      <default>London|Europe/London;New York|America/New_York;Tokyo|Asia/Tokyo</default>
    </entry>
    <!-- Top apps sort order: cpu or memory -->
    <entry name="processSort" type="String">
      <default>cpu</default>
    </entry>
    <!-- Desk pet: dog (apricot poodle) or cat -->
    <entry name="petKind" type="String">
      <default>dog</default>
    </entry>
    <!-- The pet's name, shown on a tag in the corner of its room; empty: no tag -->
    <entry name="petName" type="String">
      <default></default>
    </entry>
    <!-- How big the pet is: s, m or l -->
    <entry name="petSize" type="String">
      <default>s</default>
    </entry>
    <!-- Where walks go: mix (somewhere new each time), auto (snow when it
         snows, else the park), grass, snow or sand -->
    <entry name="petGround" type="String">
      <default>mix</default>
    </entry>
    <!-- Care buttons on the tile: always, hover or off -->
    <entry name="petButtons" type="String">
      <default>always</default>
    </entry>
    <!-- Food, fun, baths and walks run down over time -->
    <entry name="petNeeds" type="Bool">
      <default>true</default>
    </entry>
    <!-- A furnished room; off shows the pet on a plain line -->
    <entry name="petRoom" type="Bool">
      <default>true</default>
    </entry>
    <!-- The room's look: cozy (a warm living room) or nerd (a dark gaming den) -->
    <entry name="petRoomStyle" type="String">
      <default>nerd</default>
    </entry>
    <!-- Care state (JSON written by the widget): when it last ate, played... -->
    <entry name="petCare" type="String">
      <default></default>
    </entry>
    <!-- Focus timer lengths in minutes -->
    <entry name="focusMinutes" type="Int">
      <default>25</default>
    </entry>
    <entry name="breakMinutes" type="Int">
      <default>5</default>
    </entry>
    <entry name="placeRequest" type="String">
      <default></default>
    </entry>
    <entry name="weatherEnabled" type="Bool">
      <default>true</default>
    </entry>
    <!-- Empty means locate automatically from the IP address. -->
    <entry name="weatherCity" type="String">
      <default></default>
    </entry>
    <!-- Temperature unit for the PC's sensors: c or f; empty = same as the weather -->
    <entry name="sensorUnit" type="String">
      <default></default>
    </entry>
    <!-- Show the Settings button when hovering the widget (off: right-click menu only) -->
    <entry name="settingsButton" type="Bool">
      <default>true</default>
    </entry>
    <!-- Clock format: 12 or 24; empty = follow the region setting -->
    <entry name="clockFormat" type="String">
      <default></default>
    </entry>
    <!-- Temperature unit for the weather: c or f -->
    <entry name="weatherUnit" type="String">
      <default>c</default>
    </entry>
    <!-- Uptime tile. Scene: sky, ticks, binary, terminal, pulse, mood, orbit, aurora, image or plain -->
    <entry name="uptimeScene" type="String">
      <default>binary</default>
    </entry>
    <!-- short (3d 2h), long (3 days, 2 hours), clock (74:12:05) or days (3.1) -->
    <entry name="uptimeFormat" type="String">
      <default>short</default>
    </entry>
    <!-- Font family name; pixel = the bundled pixel font; empty = the look's font -->
    <entry name="uptimeFont" type="String">
      <default></default>
    </entry>
    <!-- auto, light, regular or bold -->
    <entry name="uptimeWeight" type="String">
      <default>auto</default>
    </entry>
    <!-- auto, light, dark or accent -->
    <entry name="uptimeColor" type="String">
      <default>auto</default>
    </entry>
    <!-- s, m, l or xl -->
    <entry name="uptimeSize" type="String">
      <default>m</default>
    </entry>
    <!-- bottom, center or top -->
    <entry name="uptimeAlign" type="String">
      <default>bottom</default>
    </entry>
    <!-- The tile's title; empty means "Up for" -->
    <entry name="uptimeLabel" type="String">
      <default></default>
    </entry>
    <entry name="uptimeShowBoot" type="Bool">
      <default>true</default>
    </entry>
    <entry name="uptimeShowRecord" type="Bool">
      <default>false</default>
    </entry>
    <!-- A local picture (file URL) for the image scene -->
    <entry name="uptimeImage" type="String">
      <default></default>
    </entry>
    <!-- fill (crop to the tile) or fit (whole picture) -->
    <entry name="uptimeImageFit" type="String">
      <default>fill</default>
    </entry>
    <!-- Darken the picture so the numbers stay readable, 0 to 80 percent -->
    <entry name="uptimeImageDim" type="Int">
      <default>25</default>
    </entry>
    <!-- Longest uptime seen, in seconds -->
    <entry name="uptimeRecord" type="Int">
      <default>0</default>
    </entry>
  </group>
</kcfg>
